generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CommitStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum ScheduleStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
}

enum CommitStyle {
  MINIMAL
  TIMESTAMP
  THEMED
  INVISIBLE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  integrations     GitHubIntegration[]
  repos            Repo[]
  auditLogs        AuditLog[]
  scheduledJobs    ScheduledJob[]
  commitLogs       CommitLog[]
  emergencyCommits EmergencyCommit[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? // store encrypted
  access_token       String? // store encrypted
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GitHubIntegration {
  id              String    @id @default(cuid())
  userId          String
  githubAccountId String // github numeric id or login
  login           String
  accessTokenEnc  String? // encrypted
  refreshTokenEnc String? // encrypted if available
  scopes          String?
  expiresAt       DateTime?
  revoked         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  repos Repo[]

  @@index([userId])
  @@index([githubAccountId])
}

model Repo {
  id             String    @id @default(cuid())
  userId         String
  integrationId  String? // which GitHubIntegration was used
  repoFullName   String // owner/name
  repoIdExternal String? // external id (as string) from GitHub
  isPrivate      Boolean   @default(false)
  active         Boolean   @default(true)
  config         Json? // commit styles, excluded paths, etc.
  lastCommitAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration      GitHubIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  scheduledJobs    ScheduledJob[]
  commitLogs       CommitLog[]
  repoSettings     RepoSetting[]
  emergencyCommits EmergencyCommit[]

  @@unique([repoFullName, userId])
  @@index([userId])
  @@index([integrationId])
}

model RepoSetting {
  id             String      @id @default(cuid())
  repoId         String
  timezone       String? // e.g. "Asia/Kolkata"
  commitsPerWeek Int         @default(7)
  preferredDays  Json? // array of weekdays or rules
  commitStyle    CommitStyle @default(MINIMAL)
  templates      Json? // user templates
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId])
}

model ScheduledJob {
  id             String         @id @default(cuid())
  userId         String
  repoId         String
  nextRunAt      DateTime
  lastRunAt      DateTime?
  status         ScheduleStatus @default(SCHEDULED)
  attempts       Int            @default(0)
  cronExpression String? // optional
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo       Repo        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  commitLogs CommitLog[]

  @@index([nextRunAt])
  @@index([userId, repoId])
}

model CommitLog {
  id             String       @id @default(cuid())
  scheduledJobId String?
  userId         String
  repoId         String
  commitSha      String?
  message        String
  status         CommitStatus @default(SUCCESS)
  response       Json? // response from GitHub API
  createdAt      DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo         Repo          @relation(fields: [repoId], references: [id], onDelete: Cascade)
  scheduledJob ScheduledJob? @relation(fields: [scheduledJobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([repoId])
  @@index([scheduledJobId])
}

model EmergencyCommit {
  id        String   @id @default(cuid())
  userId    String
  repoId    String
  source    String // 'DASHBOARD' | 'EMAIL' | 'API'
  message   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
